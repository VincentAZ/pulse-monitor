#!/usr/bin/env python3
"""Launcher for Pulse that works from a source checkout."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from pulse.ui.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
